{
  "comments": {
    "blockComment": ["{#", "#}"]
  },
  "brackets": [
    ["{=", "}"],
    ["{!", "!}"],
    ["{#", "#}"],
    ["<", ">"],
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "{=", "close": " }" },
    { "open": "{!", "close": " !}" },
    { "open": "{#", "close": " #}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "<", "close": ">" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" }
  ],
  "surroundingPairs": [
    ["{=", "}"],
    ["{!", "!}"],
    ["{#", "#}"],
    ["\"", "\""],
    ["'", "'"],
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#(?:slot|form|each|eachor|when|unless|signedin|signedout)\\b",
      "end": "^\\s*#(?:endslot|endform|endeach|endwhen|endunless|endsignedin|endsignedout)\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
