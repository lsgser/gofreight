GOFREIGHT_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=sqlite://db/development.db
SECRET_KEY=change-me-in-production
LOG_LEVEL=info

# Admin (development)
ADMIN_PASSWORD=

# Storage (S3 / R2 / MinIO)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
MAIL_DRIVER=log

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis
REDIS_URL=redis://localhost:6379

# Webhooks
WEBHOOK_SECRET=

# Analytics
ANALYTICS_PROVIDER=posthog
ANALYTICS_API_KEY=
